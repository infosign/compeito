# compeito の環境変数サンプル。
# macOS / 一般的なホスト OS でネイティブに開発する場合、このファイルを `.env` にコピーしてください。
# Docker Compose の app コンテナで実行する場合は docker-compose.yml の environment が優先されるため、
# `.env` の値は無視されます。

# Postgres は docker compose up -d db で起動した想定。
# Docker サービス名（db）ではなく localhost を指す点に注意。
DATABASE_URL=postgresql+asyncpg://case:case@localhost:5432/case

# Web UI / CASE API のベース URL（CFPackageURI 等の生成に使用）。
BASE_URL=http://localhost:8000

# CASE API output shape when a request asks for neither ?strict=1 nor ?compat=1.
#   compat (default) — today's shape: OpenSALT-style wrappers, null echo,
#                      package-context URIs. What existing clients read.
#   strict           — official CASE v1.1 OpenAPI shape.
# Flipping this is the planned major-version change; see
# docs/dev/designs/strict-output.md.
CASE_OUTPUT_DEFAULT=compat
